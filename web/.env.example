# Optional on Vercel: defaults to the project's production deployment URL.
# Set this explicitly when using a custom domain. It is public build-time data.
NEXT_PUBLIC_SITE_URL=

# Leave unpublished stores blank to keep their Coming soon / Planned badges.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_MICROSOFT_STORE_URL=
NEXT_PUBLIC_APPLE_STORE_URL=

# Never put backend JWT keys, wallet keys, database credentials, or Redis tokens here.
