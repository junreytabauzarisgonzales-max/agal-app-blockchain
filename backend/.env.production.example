# Reference only. Add these in the BACKEND Vercel project's Environment Variables.
# Never copy real secrets into this example or into web/NEXT_PUBLIC_* variables.
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@your-database-host/agal?sslmode=require
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://your-web-project.vercel.app
CRON_SECRET=change-this-cron-secret

# Use your existing deployed HarvestLedger and funded, authorized service wallet.
WEB3_PROVIDER_URL=
HARVEST_LEDGER_ADDRESS=
SERVICE_WALLET_PRIVATE_KEY=

# Optional admin UI: set ALL admin values plus both Redis values, or leave all blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
