PROJECT_NAME="Agal API"
ENVIRONMENT=development

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://agal:agal@localhost:5432/agal

SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=*

# Blockchain anchoring and live verification.
WEB3_PROVIDER_URL=
HARVEST_LEDGER_ADDRESS=
SERVICE_WALLET_PRIVATE_KEY=

# Run python scripts/generate_secrets.py to fill secure local JWT/cron secrets.
# Configure the same CRON_SECRET in the backend Vercel project.
CRON_SECRET=

# Super Admin UI (/admin). Leave all three unset to disable it.
# In production: password >= 12 chars, secret >= 32 random chars, no placeholders.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-secret

# Required if enabling the admin UI on Vercel; optional for single-process local use.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
